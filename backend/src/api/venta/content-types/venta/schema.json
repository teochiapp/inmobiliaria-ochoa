    },
    "Portada": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Galeria": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Habitaciones": {
      "type": "integer"
    },
    "Banos": {
      "type": "integer"
    },
    "MetrosCuadrados": {
      "type": "integer"
    },
    "Slug": {
      "type": "uid",
      "targetField": "Nombre"
    },
    "Descripcion": {
      "type": "blocks"
    }
  }
}
