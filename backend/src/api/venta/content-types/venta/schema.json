{
  "kind": "collectionType",
  "collectionName": "ventas",
  "info": {
    "singularName": "venta",
    "pluralName": "ventas",
    "displayName": "Ventas"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Nombre": {
      "type": "string"
    },
    "Ubicacion": {
      "type": "string"
    },
    "Zona": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::zona.zona"
    },
    "Precio": {
